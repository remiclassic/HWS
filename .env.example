# Hot Wheels Spotter — copy to `.env` in `apps/api` (or export in shell) for local API development.

# Required in production (min 16 characters). Dev fallback exists only when NODE_ENV !== production.
JWT_SECRET=

# APIPORT=3001
CORS_ORIGIN=*
LOG_LEVEL=info

# PostgreSQL (default matches infra/docker-compose.yml port 5433)
DATABASE_URL=postgresql://spotter:spotter_dev@localhost:5433/hotwheels_spotter

# Internal catalog ingestion (optional). When unset, POST /internal/import/* returns 503.
INTERNAL_IMPORT_KEY=

# Expo mobile — set when pointing a device or emulator at your machine
# EXPO_PUBLIC_API_URL=http://192.168.1.x:3001

# Optional crash reporting (Expo / Sentry)
# EXPO_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Expo push (server): https://expo.dev/accounts/<account>/settings/access-tokens
# EXPO_ACCESS_TOKEN=
