{
  "expo": {
    "name": "Hot Wheels Spotter",
    "slug": "hotwheels-spotter",
    "version": "1.0.0",
    "scheme": "hotwheels-spotter",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Hot Wheels Spotter to scan barcodes and take photos of cars in your garage.",
          "recordAudioAndroid": false
        }
      ],
      ["@sentry/react-native", { "uploadSourceMaps": false }],
      "expo-notifications"
    ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "hotwheels-spotter"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.CAMERA"
      ],
      "package": "com.carvedstoneinteractive.hotwheelspotter"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e568dc86-ab92-4f09-a2c7-0b27d3801b02"
      }
    }
  }
}
