# Copy to .env.local for local dev. All EXPO_PUBLIC_* are bundled into the app — never put secrets here.
EXPO_PUBLIC_ENV=local

# Leave blank to auto-detect the `supabase start` local instance.
# For release builds, set these to your hosted Supabase project:
# EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>
