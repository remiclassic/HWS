{
  "name": "hot-wheels-spotter",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "db",
    "supabase/tests"
  ],
  "scripts": {
    "postinstall": "npm run build -w @hotwheels/shared",
    "build": "npm run build -w @hotwheels/shared",
    "lint": "npm run lint -w @hotwheels/shared && npm run lint -w @hotwheels/mobile",
    "test": "npm run test -w @hotwheels/mobile && npm run test -w @hotwheels/supabase-tests",
    "test:mobile": "npm run test -w @hotwheels/mobile",
    "test:rls": "bash -c 'eval \"$(npx supabase status -o env)\" && export SUPABASE_URL=$API_URL SUPABASE_ANON_KEY=$ANON_KEY SUPABASE_SERVICE_ROLE_KEY=$SERVICE_ROLE_KEY && npm run test -w @hotwheels/supabase-tests'",
    "db:start": "npx supabase start",
    "db:stop": "npx supabase stop",
    "db:reset": "npx supabase db reset",
    "db:generate": "npm run generate -w @hotwheels/db",
    "dev": "npm run start -w @hotwheels/mobile",
    "admin": "npm run dev -w @hotwheels/admin",
    "functions": "npx supabase functions serve",
    "android:prebuild": "npm run prebuild:android -w @hotwheels/mobile",
    "build:android": "npm run build:android -w @hotwheels/mobile",
    "build:android:release": "npm run build:android:release -w @hotwheels/mobile"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "dependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  }
}
